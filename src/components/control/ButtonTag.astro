---
interface Props {
	size?: string;
	dot?: boolean;
	href?: string;
	label?: string;
}
const { dot, href, label }: Props = Astro.props;
---
<a href={href} aria-label={label} class="btn-regular h-8 text-sm px-3 rounded-lg !text-[var(--primary)] dark:!text-[var(--primary)] hover:scale-105">
    {dot && <div class="h-1 w-1 bg-[var(--primary)] transition rounded-md mr-2"></div>}
    <slot></slot>
</a>
